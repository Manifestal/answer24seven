# Supabase project URL and service_role key; NEVER expose service role in client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required for dashboard login. If omitted, dashboard denies access (no public fallback).
DASHBOARD_PASSWORD=
# Optional but strongly recommended: match Vapi assistant.server.secret.
VAPI_WEBHOOK_SECRET=
# Email is not configured in this starter. Set only after choosing and integrating a provider.
# EMAIL_PROVIDER=
